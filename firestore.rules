rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function profileShape(d) {
      return d.keys().hasAll(['name', 'email', 'marketing', 'createdAt'])
        && d.keys().hasOnly(['name', 'email', 'marketing', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.email == request.auth.token.email && d.marketing is bool
        && d.createdAt is timestamp;
    }
    match /profiles/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid) && profileShape(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && profileShape(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'marketing']);
      allow delete: if false;
    }
    match /services/{id} {
      allow read: if admin() || resource.data.archived == false;
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['name','category','description','duration','price','archived','order'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.category in ['Nails','Hair','Beauty']
        && request.resource.data.description is string && request.resource.data.description.size() <= 400
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.duration is int && request.resource.data.duration > 0
        && request.resource.data.archived is bool && request.resource.data.order is int;
      allow delete: if false;
    }
    match /promotions/{id} {
      function validOffer(d) {
        let service = get(/databases/$(database)/documents/services/$(d.serviceId)).data;
        return d.keys().hasOnly(['title','description','serviceId','price','start','end','photoId','published','order'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 80
          && d.description is string && d.description.size() <= 400
          && d.start is timestamp && d.end is timestamp && d.start <= d.end
          && d.price is number && d.price >= 0 && d.price < service.price
          && service.archived == false && d.published is bool && d.order is int
          && d.photoId is string && exists(/databases/$(database)/documents/gallery/$(d.photoId));
      }
      allow read: if admin() || resource.data.published == true;
      allow create, update: if admin() && validOffer(request.resource.data);
      allow delete: if admin();
    }
    match /gallery/{id} {
      allow read: if true;
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['url','alt','category','caption','source','placeholder','order'])
        && request.resource.data.url is string && request.resource.data.url.size() < 2048
        && request.resource.data.alt is string && request.resource.data.alt.size() > 0 && request.resource.data.alt.size() <= 200
        && request.resource.data.caption is string && request.resource.data.caption.size() > 0 && request.resource.data.caption.size() <= 100
        && request.resource.data.category in ['Nails','Hair','Beauty']
        && request.resource.data.source is string && request.resource.data.placeholder is bool && request.resource.data.order is int;
      allow delete: if admin();
    }
    match /loyalty/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false;
    }
    match /visits/{id} {
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow write: if false;
    }
    match /redemptions/{id} {
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow write: if false;
    }
    match /audit/{id} { allow read: if admin(); allow write: if false; }
    match /analytics/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
