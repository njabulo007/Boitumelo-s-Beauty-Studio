rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    match /gallery/{photoId} {
      allow read: if true;
      allow create, update: if admin() && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if admin();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
